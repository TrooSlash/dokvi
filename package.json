{
  "name": "dokvi",
  "version": "3.0.0",
  "description": "Markdown reader and editor for Windows without Electron",
  "author": {
    "name": "TrooSlash",
    "url": "https://github.com/TrooSlash"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File host/build.ps1",
    "build:ui": "node build.mjs",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build.ps1",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File test/installer.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File test/run.ps1",
    "test:unit": "node --test test/markdown.test.cjs test/history.test.cjs test/formatting.test.cjs test/i18n.test.cjs test/native-shortcuts.test.cjs",
    "test:memory": "powershell -NoProfile -ExecutionPolicy Bypass -File test/measure.ps1",
    "test:session": "powershell -NoProfile -ExecutionPolicy Bypass -File test/session.ps1",
    "test:storage": "powershell -NoProfile -ExecutionPolicy Bypass -File test/storage.ps1",
    "test:transition": "powershell -NoProfile -ExecutionPolicy Bypass -File test/transition.ps1",
    "test:frame": "powershell -NoProfile -ExecutionPolicy Bypass -File test/frame.ps1",
    "test:window": "powershell -NoProfile -ExecutionPolicy Bypass -File test/window.ps1",
    "test:click": "powershell -NoProfile -ExecutionPolicy Bypass -File test/click.ps1",
    "test:resize": "powershell -NoProfile -ExecutionPolicy Bypass -File test/resize.ps1",
    "test:shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File test/shortcuts.ps1",
    "test:input-focus": "powershell -NoProfile -ExecutionPolicy Bypass -File test/input-focus.ps1",
    "test:focus-routing": "powershell -NoProfile -ExecutionPolicy Bypass -File test/focus-routing.ps1",
    "test:taskbar-focus": "powershell -NoProfile -ExecutionPolicy Bypass -File test/taskbar-focus.ps1",
    "test:quality": "powershell -NoProfile -ExecutionPolicy Bypass -File test/quality.ps1",
    "test:native-menu": "powershell -NoProfile -ExecutionPolicy Bypass -File test/native-menu.ps1",
    "test:language": "powershell -NoProfile -ExecutionPolicy Bypass -File test/language.ps1"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "12.3.0"
  }
}
